[gd_resource type="Resource" load_steps=9 format=3]

[ext_resource type="Script" path="res://battle/battle_map_data.gd" id="1"]
[ext_resource type="Script" path="res://battle/wave_data.gd" id="2"]
[ext_resource type="PackedScene" path="res://enemies/melee_soldier.tscn" id="3"]
[ext_resource type="PackedScene" path="res://enemies/ranged_soldier.tscn" id="4"]
[ext_resource type="PackedScene" path="res://enemies/tank.tscn" id="5"]
[ext_resource type="PackedScene" path="res://enemies/drone.tscn" id="6"]

[sub_resource type="Resource" id="Wave1"]
script = ExtResource("2")
wave_id = &"first_contact"
title = "WAVE 1 // STREET PATROL"
trigger_progress = 0.08
enemy_scenes = Array[PackedScene]([ExtResource("3"), ExtResource("3"), ExtResource("4")])

[sub_resource type="Resource" id="Wave2"]
script = ExtResource("2")
wave_id = &"crossfire"
title = "WAVE 2 // CROSSFIRE"
trigger_progress = 0.30
enemy_scenes = Array[PackedScene]([ExtResource("3"), ExtResource("4"), ExtResource("4")])

[sub_resource type="Resource" id="Wave3"]
script = ExtResource("2")
wave_id = &"air_raid"
title = "WAVE 3 // AIR RAID"
trigger_progress = 0.52
spawn_rule = 3
enemy_scenes = Array[PackedScene]([ExtResource("6"), ExtResource("6")])

[sub_resource type="Resource" id="Wave4"]
script = ExtResource("2")
wave_id = &"armored_gate"
title = "ELITE // ARMORED GATE"
trigger_progress = 0.74
spawn_rule = 2
enemy_scenes = Array[PackedScene]([ExtResource("5"), ExtResource("4"), ExtResource("3")])

[resource]
script = ExtResource("1")
map_id = &"city_ruins"
display_name = "CITY RUINS"
target_duration_seconds = 150.0
waves = Array[ExtResource("2")]([SubResource("Wave1"), SubResource("Wave2"), SubResource("Wave3"), SubResource("Wave4")])
